# Server
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# PayPal Sandbox credentials (never commit real secrets)
PAYPAL_CLIENT_ID=replace_with_sandbox_client_id
PAYPAL_CLIENT_SECRET=replace_with_sandbox_secret
PAYPAL_ENV=sandbox

# Optional: if empty, the app uses its built-in budget assistant
GEMINI_API_KEY=
